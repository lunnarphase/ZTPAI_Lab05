            },
            "description": "Page size"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "startTime",
                "-startTime",
                "createdAt",
                "-createdAt",
                "participants",
                "-participants"
              ],
              "default": "startTime"
            },
            "description": "Tie-breaker: id ASC"
