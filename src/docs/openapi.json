      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "requestId": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "USER",
              "ADMIN"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "Credentials": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email is validated and normalized to lowercase before lookup or storage."
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 72,
            "writeOnly": true,
            "description": "10 to 72 characters and at most 72 UTF-8 bytes; longer byte sequences are rejected before bcrypt hashing."
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "BuildingInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "address": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "name",
          "address"
        ],
        "additionalProperties": false
      },
      "RoomInput": {
        "type": "object",
        "properties": {
          "buildingId": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "capacity": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "buildingId",
          "name",
          "capacity"
        ],
        "additionalProperties": false
      },
      "ReservationInput": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "integer",
            "minimum": 1
          },
          "participants": {
            "type": "integer",
            "minimum": 1
          },
          "startTime": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 date-time with timezone. The start must not be in the past."
          },
          "endTime": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 date-time with timezone. Must be after startTime, with a duration from 15 minutes to 8 hours inclusive."
          }
        },
        "required": [
          "roomId",
          "participants",
          "startTime",
          "endTime"
        ],
        "additionalProperties": false
      },
      "Login": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string"
          },
          "expiresIn": {
            "type": "string"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "LoginInput": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email is validated and normalized to lowercase before lookup or storage."
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false
      },
